{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MLRan-ext Metadata Record",
  "description": "Metadata manifest schema for Modernized Goodware and Ransomware Extension Benchmark (T-P10-06)",
  "type": "object",
  "properties": {
    "sample_id": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "file_name": {"type": "string"},
    "category": {
      "type": "string",
      "enum": [
        "office_productivity",
        "developer_tools",
        "utilities_compression",
        "enterprise_communication",
        "cryptographic_tools",
        "ransomware_validation"
      ]
    },
    "source_repository": {
      "type": "string",
      "enum": ["winget", "chocolatey", "portableapps", "vendor_direct", "malwarebazaar"]
    },
    "publisher": {"type": "string"},
    "os_platform": {"type": "string"},
    "vt_detection_count": {"type": "integer", "minimum": 0},
    "vt_total_engines": {"type": "integer", "minimum": 1},
    "vt_first_submission": {"type": "string", "format": "date-time"},
    "file_size_bytes": {"type": "integer", "minimum": 0},
    "static_entropy": {"type": "number", "minimum": 0.0, "maximum": 8.0},
    "is_ransomware": {"type": "integer", "enum": [0, 1]},
    "provenance_url": {"type": "string"}
  },
  "required": [
    "sample_id",
    "sha256",
    "file_name",
    "category",
    "source_repository",
    "vt_detection_count",
    "vt_first_submission",
    "is_ransomware"
